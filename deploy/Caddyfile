# The identity host: /auth/* is the identity service, plus the developer portal. The bare host and every other path are
# a plain 404, and so is a direct visit to the sign-in page: it exists only for a person a service (the IDE, the LMS)
# sends here with a `redirect`, so typing the host into a browser shows nothing and a signed-in visitor is never
# bounced into a product. Nothing here is meant to be found by search engines.
{$SITE_ADDRESS} {
	{$SITE_TLS}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}

	# GET /auth/login without a `redirect` is a direct visit. (The password form POSTs to the same path; it is not matched.)
	@bare_login {
		method GET HEAD
		path /auth/login
		not query redirect=*
	}
	handle @bare_login {
		respond "Not found" 404
	}

	handle /auth/* {
		reverse_proxy identity:8200
	}

	# The developer portal's pages (static HTML and script; its API is under /auth/admin) and the page its sign-in
	# returns to. Not exposed as a service: they carry no data and no credentials (docs/developer-portal.md).
	handle /developer* {
		reverse_proxy identity:8200
	}

	handle /handoff {
		reverse_proxy identity:8200
	}

	handle {
		respond "Not found" 404
	}
}
