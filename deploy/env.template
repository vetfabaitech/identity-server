# Identity host settings. On the server: cp infra/identity/env.template infra/identity/.env (gitignored), fill in.
# Generate secrets with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# Public address of this service. DNS A record for SITE_ADDRESS points at this server; Caddy gets the certificate.
SITE_ADDRESS=accounts.vetfab.ai
SITE_TLS=tls ops@vetfab.ai
PUBLIC_ORIGIN=https://accounts.vetfab.ai

# The products that may receive a sign-in. The LMS first. Same site (vetfab.ai) as PUBLIC_ORIGIN.
LMS_ORIGIN=https://test.vetfab.ai
IDE_ORIGIN=https://demo.vetfab.ai

# staging: test accounts allowed. production: test accounts refused.
IDENTITY_ENVIRONMENT=staging

# Database (the shared Postgres the LMS API and the IDE use).
# OWNER_DATABASE_URL: the schema owner, used only for migrations and to create the service login.
#   Supabase: Dashboard -> Connect -> "Session pooler" (port 5432, NOT the 6543 transaction pooler), e.g.
#   postgresql://postgres.<project-ref>:<db password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# IDENTITY_DATABASE_URL: the service login deploy.sh creates (IDENTITY_DB_USER / IDENTITY_DB_PASSWORD).
#   Supabase's pooler wants the user as <role>.<project-ref>, e.g. lms_identity.<project-ref>.
OWNER_DATABASE_URL=
IDENTITY_DB_USER=lms_identity
IDENTITY_DB_PASSWORD=
IDENTITY_DATABASE_URL=

# GitHub / Google sign-in (optional; a provider without both values is not offered). Register the callbacks
#   <PUBLIC_ORIGIN>/auth/oauth/github/callback   and   <PUBLIC_ORIGIN>/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that become approved administrators on their first GitHub/Google sign-in.
ADMIN_EMAILS=

# Test accounts (staging only): TEST_ACCOUNTS=true plus a passphrase of 12+ characters and the account list.
TEST_ACCOUNTS=false
TEST_ACCOUNTS_PASSPHRASE=
TEST_ACCOUNTS_EMAILS=
TEST_ACCOUNTS_PASSWORD=
