# Identity host settings. On the server: cp deploy/env.template deploy/.env (gitignored), fill in.
# Generate secrets with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# Public address of this service. DNS A record for SITE_ADDRESS points at this server; Caddy gets the certificate.
SITE_ADDRESS=auth.vetfab.ai
SITE_TLS=tls ops@vetfab.ai
PUBLIC_ORIGIN=https://auth.vetfab.ai

# The products that may receive a sign-in. The LMS first. Same site (vetfab.ai) as PUBLIC_ORIGIN.
LMS_ORIGIN=https://test.vetfab.ai
IDE_ORIGIN=https://demo.vetfab.ai
# Further products that may receive a sign-in, comma-separated origins (see docs/adapter.md). Leave empty for none.
EXTRA_APP_ORIGINS=

# Service registry (docs/developer-portal.md). The registry lives in the database and is managed in the developer portal
# at https://<PUBLIC_ORIGIN>/developer/services. SERVICES_JSON only SEEDS it: a service that is not in the database yet is
# inserted at start-up; one that already is, is never overwritten (the database wins, a differing entry is logged).
# Every seeded base_url must be one of the origins above. Make each secret_sha256 with `identity-admin service-secret`.
# Put the JSON inside single quotes: SERVICES_JSON='{"services":[...]}'. Leave empty to seed nothing.
#   {"services":[{"id":"lms","display_name":"Vetfab LMS","base_url":"https://test.vetfab.ai","secret_sha256":"<hex>"},
#                {"id":"ide","display_name":"Vetfab IDE","base_url":"https://demo.vetfab.ai","secret_sha256":"<hex>"}]}
SERVICES_JSON=
# For the portal's own sign-in to return to this host, PUBLIC_ORIGIN must also be a return origin: add it to
# EXTRA_APP_ORIGINS above (EXTRA_APP_ORIGINS=https://auth.vetfab.ai). Administrators then sign in once and open the portal.
# How long a hand-off ticket may wait to be redeemed (10 to 300 seconds).
HANDOFF_TICKET_SECONDS=60
# How stale one instance's copy of the registry's sign-in origins may get (seconds), and how long a rotated service
# secret keeps working so the service can be updated (seconds; 0 revokes at once).
REGISTRY_REFRESH_SECONDS=5
SECRET_ROTATION_GRACE_SECONDS=3600
# Portal changes per administrator per rate-limit window (secret operations get a sixth).
ADMIN_RATE_LIMIT=60

# Silent single sign-on. false (default): a service that sends someone here always gets the sign-in page, where they
# pick GitHub, Google or a password for that service. true: a live session signs them in to the next service without asking.
SILENT_SIGN_IN=false

# Resource limits of the identity container: CPUs and memory. 1 CPU / 4g is what this service is sized for.
IDENTITY_CPUS=1
IDENTITY_MEMORY_LIMIT=4g

# staging: test accounts allowed. production: test accounts refused.
IDENTITY_ENVIRONMENT=staging

# Database (the shared Postgres the LMS API and the IDE use).
# OWNER_DATABASE_URL: the schema owner, used only for migrations and to create the service login.
#   Supabase: Dashboard -> Connect -> "Session pooler" (port 5432, NOT the 6543 transaction pooler), e.g.
#   postgresql://postgres.<project-ref>:<db password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# IDENTITY_DATABASE_URL: the service login deploy.sh creates (IDENTITY_DB_USER / IDENTITY_DB_PASSWORD).
#   Supabase's pooler wants the user as <role>.<project-ref>, e.g. lms_identity.<project-ref>.
OWNER_DATABASE_URL=
IDENTITY_DB_USER=lms_identity
IDENTITY_DB_PASSWORD=
IDENTITY_DATABASE_URL=

# GitHub / Google sign-in (optional; a provider without both values is not offered). Register the callbacks
#   <PUBLIC_ORIGIN>/auth/oauth/github/callback   and   <PUBLIC_ORIGIN>/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that become approved administrators on their first GitHub/Google sign-in.
ADMIN_EMAILS=

# Test accounts (staging only): TEST_ACCOUNTS=true plus a passphrase of 12+ characters and the account list.
TEST_ACCOUNTS=false
TEST_ACCOUNTS_PASSPHRASE=
TEST_ACCOUNTS_EMAILS=
TEST_ACCOUNTS_PASSWORD=
